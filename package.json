{
  "name": "anvilts",
  "version": "0.0.0",
  "private": true,
  "description": "MCP-powered formal verification for concurrent systems",
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts",
    "parity": "node parity/run-cases.ts",
    "build": "npm run build:mcp",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugins/anvilts/mcp/server.mjs",
    "mcp": "node src/mcp/server.ts",
    "test:mcp": "node src/mcp/smoke-test.ts",
    "test:plugin": "node src/mcp/plugin-smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mcp": "npm run typecheck"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@viz-js/viz": "^3.28.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
